{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#201F1D",
    "--editor-surface": "#2A2927",
    "--foreground": "#EDEBE6",
    "--card-foreground": "#EDEBE6",
    "--popover-foreground": "#EDEBE6",
    "--secondary-foreground": "#EDEBE6",
    "--accent-foreground": "#EDEBE6",
    "--sidebar-foreground": "#EDEBE6",
    "--sidebar-accent-foreground": "#EDEBE6",
    "--worktree-sidebar-foreground": "#EDEBE6",
    "--worktree-sidebar-accent-foreground": "#EDEBE6",
    "--tab-active-foreground": "#EDEBE6",
    "--card": "#2E2D2B",
    "--popover": "#33322F",
    "--primary": "#D97757",
    "--ring": "#D97757",
    "--sidebar-primary": "#D97757",
    "--sidebar-ring": "#D97757",
    "--worktree-sidebar-ring": "#D97757",
    "--tab-active-indicator": "#D97757",
    "--split-divider-hover": "#D97757",
    "--chart-1": "#D97757",
    "--primary-foreground": "#1A1715",
    "--sidebar-primary-foreground": "#1A1715",
    "--secondary": "#32312E",
    "--muted": "#32312E",
    "--muted-foreground": "#B5B2AB",
    "--host-badge-foreground": "#B5B2AB",
    "--tab-inactive-foreground": "#B5B2AB",
    "--git-decoration-ignored": "#8A8780",
    "--accent": "#393835",
    "--sidebar-accent": "#31302D",
    "--worktree-sidebar-accent": "#31302D",
    "--worktree-sidebar-active": "#363532",
    "--host-badge": "#393835",
    "--border": "#373633",
    "--input": "#464541",
    "--sidebar-border": "#373633",
    "--worktree-sidebar-border": "#373633",
    "--worktree-sidebar-active-border": "#464541",
    "--split-divider": "#373633",
    "--sidebar": "#201F1D",
    "--worktree-sidebar": "#201F1D",
    "--tab-bar": "#201F1D",
    "--tab-inactive": "#201F1D",
    "--tab-active": "#2A2927",
    "--chat-user-message": "#363532",
    "--text-link": "#8DB5E0",
    "--diff-added": "#A0C98B",
    "--git-decoration-added": "#A0C98B",
    "--git-decoration-untracked": "#A0C98B",
    "--chart-2": "#A0C98B",
    "--diff-removed": "#EA8C8D",
    "--git-decoration-deleted": "#EA8C8D",
    "--git-decoration-modified": "#DEB870",
    "--chart-3": "#DEB870",
    "--git-decoration-renamed": "#95BDDA",
    "--chart-4": "#95BDDA",
    "--git-decoration-copied": "#C6AADC",
    "--chart-5": "#C6AADC",
    "--diff-added-background": "#283625",
    "--diff-added-gutter": "#2E4029",
    "--diff-removed-background": "#422A29",
    "--diff-removed-gutter": "#50302E",
    "--diff-added-emphasis": "#334B2D",
    "--diff-removed-emphasis": "#563130",
    "--chat-bold-foreground": "#F7F5F0",
    "--chat-muted-foreground": "#ADA9A1",
    "--chat-inline-code": "#403E3A",
    "--chat-inline-code-foreground": "#E8E5DF",
    "--chat-code-block": "#31302D",
    "--chat-selection": "#354A5F",
    "--chat-selection-foreground": "#EDEBE6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9A968E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#C6AADC"
      }
    },
    {
      "scope": [
        "string",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A0C98B"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E49A7C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#95BDDA"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8EC7C3"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#EDEBE6"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B5B2AB"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#EA8C8D"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#EDEBE6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8DB5E0",
        "fontStyle": "underline"
      }
    }
  ]
}
