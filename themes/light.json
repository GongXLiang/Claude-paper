{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#F9F8F5",
    "--editor-surface": "#F9F8F5",
    "--foreground": "#1F1E1C",
    "--card-foreground": "#1F1E1C",
    "--popover-foreground": "#1F1E1C",
    "--secondary-foreground": "#1F1E1C",
    "--accent-foreground": "#1F1E1C",
    "--sidebar-foreground": "#1F1E1C",
    "--sidebar-accent-foreground": "#1F1E1C",
    "--worktree-sidebar-foreground": "#1F1E1C",
    "--worktree-sidebar-accent-foreground": "#1F1E1C",
    "--tab-active-foreground": "#1F1E1C",
    "--card": "#FCFCFA",
    "--popover": "#FFFFFF",
    "--primary": "#AC4B2B",
    "--ring": "#AC4B2B",
    "--sidebar-primary": "#AC4B2B",
    "--sidebar-ring": "#AC4B2B",
    "--worktree-sidebar-ring": "#AC4B2B",
    "--tab-active-indicator": "#AC4B2B",
    "--split-divider-hover": "#AC4B2B",
    "--chart-1": "#AC4B2B",
    "--primary-foreground": "#FFFFFF",
    "--sidebar-primary-foreground": "#FFFFFF",
    "--secondary": "#ECEBE7",
    "--muted": "#ECEBE7",
    "--muted-foreground": "#65625C",
    "--host-badge-foreground": "#65625C",
    "--tab-inactive-foreground": "#65625C",
    "--git-decoration-ignored": "#7F7C75",
    "--accent": "#E6E5E0",
    "--sidebar-accent": "#E6E5E0",
    "--worktree-sidebar-accent": "#E6E5E0",
    "--worktree-sidebar-active": "#E1E0DA",
    "--host-badge": "#E6E5E0",
    "--border": "#E2E0DB",
    "--input": "#D5D3CD",
    "--sidebar-border": "#E2E0DB",
    "--worktree-sidebar-border": "#E2E0DB",
    "--worktree-sidebar-active-border": "#D5D3CD",
    "--split-divider": "#E2E0DB",
    "--sidebar": "#F3F2EF",
    "--worktree-sidebar": "#F3F2EF",
    "--tab-bar": "#F3F2EF",
    "--tab-inactive": "#F3F2EF",
    "--tab-active": "#F9F8F5",
    "--chat-user-message": "#EEEDE9",
    "--text-link": "#295E90",
    "--diff-added": "#416A33",
    "--git-decoration-added": "#416A33",
    "--git-decoration-untracked": "#416A33",
    "--chart-2": "#416A33",
    "--diff-removed": "#A6383C",
    "--git-decoration-deleted": "#A6383C",
    "--git-decoration-modified": "#8F6213",
    "--chart-3": "#8F6213",
    "--git-decoration-renamed": "#356890",
    "--chart-4": "#356890",
    "--git-decoration-copied": "#785288",
    "--chart-5": "#785288",
    "--diff-added-background": "#E8F3E3",
    "--diff-added-gutter": "#DCECD4",
    "--diff-removed-background": "#FBE6E4",
    "--diff-removed-gutter": "#F8D8D6",
    "--diff-added-emphasis": "#CFE6C6",
    "--diff-removed-emphasis": "#F8D3CF",
    "--chat-bold-foreground": "#161513",
    "--chat-muted-foreground": "#5F5C56",
    "--chat-inline-code": "#E6E4DE",
    "--chat-inline-code-foreground": "#2B2A27",
    "--chat-code-block": "#F3F2EF",
    "--chat-selection": "#D1E2F3",
    "--chat-selection-foreground": "#1F1E1C"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#75726B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#785288"
      }
    },
    {
      "scope": [
        "string",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#416A33"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#AC4B2B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#356890"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#287070"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#1F1E1C"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#65625C"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#A6383C"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#1F1E1C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#295E90",
        "fontStyle": "underline"
      }
    }
  ]
}
